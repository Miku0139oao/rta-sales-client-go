# Live web edition for RTA 銷售分析.
# Cloudflare orange-cloud terminates visitor TLS and proxies to this origin.
# Origin uses Caddy's internal cert so Cloudflare Full TLS can handshake.
# Full (strict) needs a Cloudflare Origin CA certificate instead.

rtasales.com, www.rtasales.com {
	tls internal
	encode zstd gzip

	# CF-Connecting-IP is trustworthy only when the TCP peer belongs to Cloudflare.
	@cloudflare {
		remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	}
	handle @cloudflare {
		reverse_proxy 127.0.0.1:8787 {
			header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
			header_up X-Real-IP {http.request.header.CF-Connecting-IP}
		}
	}
	handle {
		reverse_proxy 127.0.0.1:8787 {
			header_up -CF-Connecting-IP
			header_up X-Forwarded-For {remote_host}
			header_up X-Real-IP {remote_host}
		}
	}

	@versionedAssets path /assets/*
	header @versionedAssets Cache-Control "public, max-age=31536000, immutable"

	header {
		Strict-Transport-Security "max-age=31536000;"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

# Keep the previous preview host working until bookmarks move over.
pre-rtasales.on9.uk {
	encode zstd gzip

	reverse_proxy 127.0.0.1:8787

	@versionedAssets path /assets/*
	header @versionedAssets Cache-Control "public, max-age=31536000, immutable"

	header {
		Strict-Transport-Security "max-age=31536000;"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}
