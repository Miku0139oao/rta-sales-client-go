{
  "name": "rta-sales-desktop-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite --mode web",
    "build": "vite build",
    "build:web": "vite build --mode web",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:emoji": "node scripts/no-emoji.mjs",
    "pdf:validate": "node --experimental-strip-types scripts/sales-report-pdf-validate.mjs",
    "verify": "bun run lint:emoji && bun run check && bun run test && bun run build"
  },
  "dependencies": {
    "@fontsource/material-symbols-rounded": "^5.2.25",
    "@material/web": "^2.4.1",
    "@wailsio/runtime": "3.0.0-beta.7",
    "harfbuzzjs": "^1.6.0",
    "jspdf": "^4.2.1",
    "svelte": "^5.38.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.1.0",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/svelte": "^5.2.8",
    "@tsconfig/svelte": "^5.0.5",
    "@types/node": "^24.2.1",
    "jsdom": "^26.1.0",
    "pdfjs-dist": "^6.3.289",
    "svelte-check": "^4.3.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "vitest": "^3.2.4"
  }
}
