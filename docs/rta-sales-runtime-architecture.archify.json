  "cards": [
    {
      "dot": "cyan",
      "title": "Primary path — fill a workbook",
      "items": [
        "Scan is network-free; Analyze fingerprints the source, maps stores, and deduplicates daily jobs into authenticated cookie lanes.",
        "The preview stays in memory. Apply rechecks source identity, preserves formulas, and atomically publishes a distinct new XLSX."
      ]
    },
    {
      "dot": "violet",
      "title": "Runtime modes and features",
      "items": [
        "Primary: Windows Wails + WebView2. Web uses Cloudflare/Caddy, per-cookie memory state, SSE, and private temp files; CLI calls the core directly.",
        "Sales analysis bypasses xlsxfill, returns current data first, completes comparisons in the background, and exports PDF or Markdown."
      ]
    },
    {
      "dot": "rose",
      "title": "Trust, secrets, and external services",
      "items": [
        "Renderer, browser, and workbook inputs are untrusted. Desktop uses Credential Manager + DPAPI; web retains secrets in localStorage and session memory.",
        "Only RTA Client crosses outbound HTTPS; four RTA hosts are collapsed into one node, with serial cookie lanes and bounded retry/concurrency."
      ]
    }
  ]
